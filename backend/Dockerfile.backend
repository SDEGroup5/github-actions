# Building
FROM python:3.14.8-alpine3.24
# Preliminary steps
WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir nuitka
# psycopg2 and Nuitka build requirements
RUN apk add --no-cache \
        build-base \
        postgresql-dev
RUN pip install --no-cache-dir patchelf
# Configuration
ENV OUTPUT_DIR=/app/bin
ENV OUTPUT_FILENAME=backend
# Create output directory
RUN mkdir -p ${OUTPUT_DIR}
# Install dependencies
COPY requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
# Copy source code
COPY . .
# Build the application
RUN python -m nuitka \
    --standalone --onefile \
    --output-dir=${OUTPUT_DIR} \
    --output-filename=${OUTPUT_FILENAME} \
    src/main.py

# Release
FROM alpine:3.24.2
WORKDIR /app
COPY --from=0 /app/bin/backend /app/backend
RUN apk add --no-cache libpq
RUN chmod +x /app/backend
CMD ["/app/backend"]
